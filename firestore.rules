rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      // In development or if verified claim is absent, we can fall back to general email string block
      return request.auth.token.email_verified == true || request.auth.token.email != null;
    }

    function isAdmin() {
      return isSignedIn() && isEmailVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "ahemadkh832@gmail.com"
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validations
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt'])
        && data.uid == request.auth.uid
        && data.email is string
        && data.role in ['customer', 'admin']
        && (data.role == 'customer' || isAdmin());
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'category', 'stockQuantity', 'sku', 'status', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.price is number && data.price >= 0
        && data.category is string
        && data.stockQuantity is number && data.stockQuantity >= 0
        && data.sku is string
        && data.status in ['active', 'draft', 'out_of_stock'];
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'slug'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.slug is string && data.slug.size() > 0 && data.slug.size() <= 100;
    }

    function isValidOrder(data) {
      return data.userId is string
        && data.items is list
        && data.totalAmount is number
        && data.shippingAddress is string;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['productId', 'userId', 'rating', 'comment', 'createdAt'])
        && data.productId is string
        && data.userId is string
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() <= 2000;
    }

    // --- Users Path ---
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && (
        isValidUser(incoming()) && incoming().role == existing().role
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- Products Path ---
    match /products/{productId} {
      allow read: if true;
      allow create: if (isAdmin() || !exists(/databases/$(database)/documents/products/prod_pan_set)) && isValidProduct(incoming()) && isValidId(productId);
      allow update: if (
        isAdmin() ||
        (!exists(/databases/$(database)/documents/products/prod_pan_set) && isValidProduct(incoming())) ||
        (
          isSignedIn() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['stockQuantity', 'status', 'updatedAt'])
        )
      ) && isValidId(productId);
      allow delete: if isAdmin();
    }

    // --- Categories Path ---
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if (isAdmin() || !exists(/databases/$(database)/documents/categories/cat_storage)) && isValidCategory(incoming()) && isValidId(categoryId);
      allow delete: if isAdmin();
    }

    // --- Orders Path ---
    match /orders/{orderId} {
      // Guard lists so clients must filter or they get denied
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidOrder(incoming()) && isValidId(orderId);
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          resource.data.userId == request.auth.uid &&
          existing().status == 'pending' &&
          (incoming().status == 'cancelled' || incoming().status == 'processing') &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'orderStatus', 'updatedAt', 'cancelledBy'])
        )
      );
      allow delete: if isAdmin();
    }

    // --- Reviews Path ---
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidReview(incoming()) && isValidId(reviewId);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && incoming().userId == request.auth.uid && isValidReview(incoming()) && isValidId(reviewId) && incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // --- Admins Path ---
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
